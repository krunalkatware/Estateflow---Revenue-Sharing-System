# EstateFlow Enterprise SaaS — Environment Configuration

# Server Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Security & JWT Secrets
SECRET_KEY=estateflow_super_secret_jwt_key_change_in_production_2026
